# ---------------------------------------------------------------
# AESRI Campus Portal — environment settings
# Copy this file to `.env` and fill in the values.
# ---------------------------------------------------------------

# Database. Leave empty to use the built-in local database
# (stored in ./.data/db) — fine for trying the portal on your computer.
# In production use a real PostgreSQL database, for example:
# DATABASE_URL=postgres://user:password@host:5432/aesri_portal?sslmode=require
# A production server refuses to start without it, unless PGLITE_DIR is set
# to say on purpose where the built-in database should keep its files.
DATABASE_URL=
# Most database connections this server keeps open (default 10).
# DATABASE_POOL_SIZE=10

# A long random secret (at least 32 characters). It protects one-time
# codes, sessions and two-factor secrets. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Keep it the same across restarts: changing it cancels all unused slips.
APP_SECRET=

# The public website (the sign-in pages link back to it). Default https://aesrischools.org.
WEBSITE_URL=https://aesrischools.org

# The public address of the portal (used in QR codes on slips and in
# payment callbacks). Required on a production server, where it must start
# with https:// (over http, sign-in cookies can't be marked Secure) —
# unless ALLOW_HTTP_APP_URL=1 says on purpose that this is a test server.
APP_URL=http://localhost:3001
ALLOW_HTTP_APP_URL=

# How many reverse proxies (nginx, Caddy, a load balancer, Cloudflare…)
# stand between visitors and this server. The portal reads the visitor's
# address that many entries from the right of X-Forwarded-For (used to
# slow down password guessing and in the activity log). One proxy (the
# usual set-up) = 1; Cloudflare in front of nginx = 2. Caddy replaces the
# header unless its trusted_proxies lists the proxies in front of it, so
# Cloudflare (proxied) in front of Caddy is 2 only with trusted_proxies set;
# with Cloudflare as DNS only it stays 1. Never expose the Node port
# directly; see docs/DEPLOYMENT.md.
TRUSTED_PROXY_HOPS=1

# Online payments. "mock" is a built-in test checkout that never
# moves real money. Switch to "razorpay" once AESRI has an account.
# On a production server the test checkout, and Razorpay's test keys
# (rzp_test_…), are refused unless ALLOW_TEST_PAYMENTS=1 (only ever for a
# demo or staging server: test payments move no money).
PAYMENT_PROVIDER=mock
ALLOW_TEST_PAYMENTS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Every 10 minutes the server asks Razorpay about unfinished online payments,
# in case one was paid but never got a receipt. "off" stops it on this server
# (another server or a scheduled `npm run payments:check` does it).
PAYMENTS_CHECK=

# Text messages (SMS) to families and staff. See docs/SMS.md.
# Leave SMS_PROVIDER empty until DLT registration is done: on a laptop the
# messages are then written to the server's log ("test mode"); on the
# school's server they are recorded as "not sent". msg91 or fast2sms to send.
SMS_PROVIDER=
# MSG91 → API → Auth key (with SMS_PROVIDER=msg91).
MSG91_AUTH_KEY=
# Fast2SMS → Dev API → API key (with SMS_PROVIDER=fast2sms).
FAST2SMS_API_KEY=
# The 6-letter DLT sender ID (header): one for both schools, e.g. AESRIS, or
# one per school, e.g. aryavart:ARYAPS,aadharshila:AADHPS. Needed for
# Fast2SMS; MSG91 takes it from each template.
SMS_SENDER_ID=
# The portal address written into the messages (default: APP_URL). Must
# start with https:// and match the registered templates exactly.
SMS_PORTAL_ADDRESS=
# "off" stops this server from sending (another server or a scheduled
# `npm run sms:send` does it).
SMS_WORKER=
# For trying things out only: shorter waits before attendance, remark and
# fee messages go (defaults 600, 180 and 120 seconds), and how often the
# sender looks for due messages (default 30).
# SMS_ATTENDANCE_DELAY_SECONDS=20
# SMS_REMARK_DELAY_SECONDS=10
# SMS_PAYMENT_DELAY_SECONDS=10
# SMS_WORKER_INTERVAL_SECONDS=5

# Hindi for families: what teachers and the office write in English
# (homework, notices, remarks…) is translated into Hindi for families who
# chose हिं. See docs/TRANSLATION.md. Leave TRANSLATE_PROVIDER empty and
# nothing is sent: Hindi readers see that text in English, marked as such
# (the demo's own texts come with their Hindi).
#   TRANSLATE_PROVIDER         azure (Microsoft Translator; free tier F0: 2 million characters a month)
#   AZURE_TRANSLATOR_KEY       Azure portal → the Translator resource → Keys and Endpoint → KEY 1
#   AZURE_TRANSLATOR_REGION    the resource's region, e.g. centralindia
#   AZURE_TRANSLATOR_ENDPOINT  leave empty (https://api.cognitive.microsofttranslator.com)
#   TRANSLATE_WAIT_MS          how long a page waits for a new translation (default 2500)
TRANSLATE_PROVIDER=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Stud-AI: each student's estimated risk of not passing the next exam in
# every subject, for class teachers in "Needs support" (docs/STUD-AI.md).
# It runs on this machine as a short Python program; nothing goes over the
# network. Leave STUD_AI_DIR empty and there are simply no estimates.
#   STUD_AI_DIR      the Stud-AI folder (with stud_ai/ and models/), e.g.
#                    ../Stud-AI on your computer, /srv/stud-ai on the server
#   STUD_AI_PYTHON   the Python to run it with (default: the folder's own
#                    .venv or .venv.nosync, otherwise python3)
#   STUD_AI_TIMEOUT_SECONDS  longest one run may take (default 30)
STUD_AI_DIR=
# STUD_AI_DIR=../Stud-AI
# STUD_AI_PYTHON=/srv/stud-ai/.venv/bin/python

# Keeps form submissions working across restarts and new versions. Must be
# 32 random bytes in base64, set both when building and when running:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Development only. Production uses scripts/with-production-secrets.mjs (`npm start`,
# `npm run production -- …`), which reads one JSON secret: from a locked file outside the app
# folder (AESRI_SECRET_FILE: a systemd credential path, or - for standard input), or from AWS
# Secrets Manager (AESRI_SECRET_ID and AWS_REGION). See docs/DEPLOYMENT.md.
# Trusted model and card SHA-256 pins must both be supplied in production.
# Development falls back to Stud-AI/stud_ai/trusted_artifacts.json shipped with source.
STUD_AI_MODEL_SHA256=
STUD_AI_CARD_SHA256=
STUD_AI_PER_MINUTE=20
STUD_AI_PER_DAY=200
